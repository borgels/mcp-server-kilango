# --- Kilango operator API ---
# Base URL of the Kilango gateway operator plane. Prod: https://api.kilango.com
# For staging/dev, point at the dev gateway's own host.
KILANGO_API_BASE_URL=https://api.kilango.com

# Public origin this MCP host is reachable on (used to build the /kilango/connect-app
# enrollment URL that the operator opens in a browser). Per company host, e.g.
# https://kilango.bos.mcp.borgels.com
KILANGO_PUBLIC_BASE_URL=

# Shared, workspace-bound Kilango API key (hub_live_… / hub_test_…). The key self-scopes
# to exactly one workspace. Mint an ADMIN write key in Kilango Studio so full portal
# building (incl. deletes/publish) works. Delivered server-to-server, never via chat.
KILANGO_API_KEY=

# Coarse instance kill-switch (defense in depth). The key's own role/scopes are the real
# boundary. When false, every non-GET operation is blocked (incl. kilango_call_operation
# on write ops and app connections).
KILANGO_ENABLE_WRITES=true

# Request timeout (ms) for calls to the Kilango API.
KILANGO_TIMEOUT_MS=30000

# Optional JSONL audit log path. Records tool, operationId, actingAs (X-MCP-User),
# status — never the API key or any connection secret.
KILANGO_AUDIT_LOG=

# --- MCP HTTP transport (shared with the fleet) ---
MCP_HTTP_HOST=127.0.0.1
MCP_MAX_BODY_BYTES=10485760
MCP_ALLOWED_ORIGINS=
MCP_ALLOW_ANY_ORIGIN=false
# Protects the loopback /mcp path (set in internal.env on the server). If empty, /mcp is
# open on the loopback port — always set this in production.
MCP_HTTP_TOKEN=
