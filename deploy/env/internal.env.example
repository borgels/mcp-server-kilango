# ~/mcp/env/internal.env is shared by every fleet service. It must set MCP_HTTP_TOKEN so the
# loopback /mcp port (published for the enrollment bypass) is not open — the gateway sends
# this same bearer when it proxies /mcp.
MCP_HTTP_HOST=0.0.0.0
PORT=3000
MCP_HTTP_TOKEN=<shared loopback bearer, same as the rest of the fleet>
