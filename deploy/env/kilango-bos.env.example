# ~/mcp/env/kilango-bos.env (chmod 600). One file per company; change the values per host.
KILANGO_API_BASE_URL=https://api.kilango.com
KILANGO_PUBLIC_BASE_URL=https://kilango.bos.mcp.borgels.com
# Shared, workspace-bound key for THIS company's Kilango workspace. Mint an ADMIN write
# key (hub_live_…) in Kilango Studio and paste it here. Never commit; deliver server-to-server.
KILANGO_API_KEY=
KILANGO_ENABLE_WRITES=true
KILANGO_TIMEOUT_MS=30000
KILANGO_AUDIT_LOG=/data/audit.jsonl
